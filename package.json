{
  "name": "graftling-dsh",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "src/graftling/dsh/plugin.mjs",
  "exports": { ".": "./src/graftling/dsh/plugin.mjs", "./client": "./src/graftling/dsh/client.mjs" },
  "files": ["src/graftling", "docs/install", "PUBLIC_API.md", "pyproject.toml"],
